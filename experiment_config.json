{
    "experiment": "Experiment 02",
    "project": "SatQuery AI",
    "task": "Semantic Segmentation",
    "dataset": "LoveDA",
    "dataset_source": "https://zenodo.org/records/5706578",
    "architecture": "DeepLabV3+",
    "encoder": "ResNet-50",
    "encoder_weights": "ImageNet",
    "num_classes": 7,
    "class_names": [
        "Background",
        "Building",
        "Road",
        "Water",
        "Barren",
        "Forest",
        "Agriculture"
    ],
    "original_label_mapping": {
        "0": "Ignore (No-data)",
        "1": "Background",
        "2": "Building",
        "3": "Road",
        "4": "Water",
        "5": "Barren",
        "6": "Forest",
        "7": "Agriculture"
    },
    "model_label_mapping": {
        "original_0": 255,
        "original_1_to_7": "0_to_6"
    },
    "input_channels": 3,
    "input_patch_size": 512,
    "original_image_size": 1024,
    "patch_strategy": "Four non-overlapping quadrants",
    "training_samples_per_epoch": 2522,
    "validation_patches": 6676,
    "batch_size": 4,
    "epochs": 10,
    "optimizer": "AdamW",
    "learning_rate_initial": 0.0001,
    "weight_decay": 0.0001,
    "loss": "CrossEntropyLoss",
    "ignore_index": 255,
    "scheduler": "ReduceLROnPlateau",
    "mixed_precision": "FP16",
    "augmentation": [
        "Random horizontal flip",
        "Random vertical flip",
        "Random 90-degree rotation"
    ],
    "normalization": {
        "mean": [
            0.485,
            0.456,
            0.406
        ],
        "std": [
            0.229,
            0.224,
            0.225
        ]
    },
    "hardware": "NVIDIA Tesla T4",
    "best_checkpoint_epoch": 10
}